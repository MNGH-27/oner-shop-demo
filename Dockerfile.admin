FROM node:22-bookworm-slim AS build

WORKDIR /app
ENV CI=true

ARG VITE_API_BASE_URL
ARG VITE_MEDIA_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_MEDIA_BASE_URL=${VITE_MEDIA_BASE_URL}

COPY package.json package-lock.json ./
COPY apps/oner-ir/package.json apps/oner-ir/package.json
COPY apps/shop-admin-panel/package.json apps/shop-admin-panel/package.json
COPY apps/shop-backend/package.json apps/shop-backend/package.json
RUN npm ci

COPY apps/shop-admin-panel apps/shop-admin-panel
RUN npm run build:admin

FROM nginx:1.28-alpine AS runtime

COPY deploy/admin.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/shop-admin-panel/dist /usr/share/nginx/html

EXPOSE 80

