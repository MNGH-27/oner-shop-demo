FROM node:22-bookworm-slim AS build

WORKDIR /app
ENV CI=true

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MEDIA_URL
ARG NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_MEDIA_URL=${NEXT_PUBLIC_MEDIA_URL}
ENV NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=${NEXT_PUBLIC_ENABLE_DEMO_FALLBACK}

COPY package.json package-lock.json ./
COPY apps/oner-ir/package.json apps/oner-ir/package.json
COPY apps/shop-admin-panel/package.json apps/shop-admin-panel/package.json
COPY apps/shop-backend/package.json apps/shop-backend/package.json
RUN npm ci

COPY apps/oner-ir apps/oner-ir
RUN npm run build:store

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/apps/oner-ir/.next/standalone ./
COPY --from=build /app/apps/oner-ir/.next/static ./apps/oner-ir/.next/static
COPY --from=build /app/apps/oner-ir/public ./apps/oner-ir/public

EXPOSE 3000
CMD ["node", "apps/oner-ir/server.js"]
