PORT=5000
DATABASE_URL=postgresql://oner:change-me@127.0.0.1:5432/oner_shop?schema=public
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d
# ورود پیامکی: در توسعه console کد را فقط در لاگ محلی چاپ می‌کند.
SMS_PROVIDER=console
# برای محیط واقعی SMS_PROVIDER را smsir قرار دهید.
SMSIR_API_KEY=
# شناسه عددی قالب ارسال سریع در پنل SMS.ir
SMSIR_TEMPLATE_ID=
# نام متغیر کد در قالب؛ حروف بزرگ و کوچک مهم است
SMSIR_CODE_PARAMETER=Code
# یک رشته تصادفی مستقل و حداقل ۳۲ کاراکتری (در نبود آن JWT_SECRET استفاده می‌شود)
OTP_PEPPER=change-me-to-another-random-secret-at-least-32-characters
OTP_EXPIRES_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_MAX_REQUESTS_PER_IP=20
SEED_ADMIN=true
SEED_DEMO=true
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=09120000000
# اعلان موجودی کم — بات را ادمین گروه کنید
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# در ایران لازم است: پروکسی HTTP لوکال VPN مثل http://127.0.0.1:7890
TELEGRAM_PROXY=
# اختیاری: آدرس جایگزین API
# TELEGRAM_API_BASE=https://api.telegram.org
ADMIN_PANEL_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# پرداخت: mock برای تست کامل محلی، zarinpal برای محیط واقعی
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_BASE_URL=http://127.0.0.1:5000
STOREFRONT_URL=http://localhost:3000
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
