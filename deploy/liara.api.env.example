NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/DATABASE?schema=public
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

SMS_PROVIDER=smsir
SMSIR_API_KEY=set-in-liara-console
SMSIR_TEMPLATE_ID=123456
SMSIR_CODE_PARAMETER=Code
OTP_PEPPER=generate-a-different-random-secret-with-at-least-32-characters
OTP_EXPIRES_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_MAX_REQUESTS_PER_IP=20

SEED_ADMIN=true
SEED_DEMO=false
ADMIN_EMAIL=admin@example.ir
ADMIN_PASSWORD=set-a-strong-password-with-at-least-12-characters
ADMIN_PHONE=09120000000

ADMIN_PANEL_URL=https://admin.example.ir
CORS_ORIGINS=https://example.ir,https://www.example.ir,https://admin.example.ir

PAYMENT_PROVIDER=zarinpal
PAYMENT_CALLBACK_BASE_URL=https://api.example.ir
STOREFRONT_URL=https://example.ir
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

