# آدرس عمومی سرور بدون اسلش انتهایی
PUBLIC_API_URL=http://SERVER_IP:5000/api
PUBLIC_MEDIA_URL=http://SERVER_IP:5000

# دیتابیس داخلی Docker؛ حداقل ۲۴ کاراکتر تصادفی
POSTGRES_PASSWORD=replace-with-a-strong-random-password

NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
OTP_PEPPER=replace-with-another-random-secret-at-least-32-characters

SMS_PROVIDER=smsir
SMSIR_API_KEY=replace-with-smsir-api-key
SMSIR_TEMPLATE_ID=123456
SMSIR_CODE_PARAMETER=Code

SEED_ADMIN=true
SEED_DEMO=true
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PHONE=09120000000

ADMIN_PANEL_URL=http://SERVER_IP:8080
CORS_ORIGINS=http://SERVER_IP,http://SERVER_IP:8080

# برای تست بدون دامنه و مرچنت واقعی
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_BASE_URL=http://SERVER_IP:5000
STOREFRONT_URL=http://SERVER_IP
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

